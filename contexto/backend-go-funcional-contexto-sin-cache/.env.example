# Configuración de Zoho Bigin
ZOHO_CLIENT_ID=tu_client_id
ZOHO_CLIENT_SECRET=tu_client_secret
ZOHO_REFRESH_TOKEN=tu_refresh_token
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
BIGIN_API_URL=https://www.zohoapis.com/bigin/v2
PORT=8000

# Nota: Al generar el token, asegúrate de incluir los siguientes scopes:
# ZohoBigin.settings.modules.READ ZohoBigin.modules.ALL
# Para acceder a settings/pipelines se requiere: ZohoBigin.settings.ALL, ZohoBigin.settings.modules.ALL o ZohoBigin.settings.modules.READ